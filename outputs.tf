# ==============================================================================
# outputs.tf : Output Values Definition
# ==============================================================================
# Purposes:
# 1. Displays critical data upon successful execution (IPs, URLs, Hostnames, ARNs).
# 2. Feeds values into downstream modules, automation scripts, or CI/CD pipelines.

# 1. Output generated random server name
output "generated_server_name" {
  description = "Unique server name generated by random_pet"
  value       = random_pet.server_name.id
}

# 2. Output generated config file path
output "config_file_path" {
  description = "Local path to the generated application configuration file"
  value       = local_file.config_file.filename
}

# 3. Output list of all worker node file paths using a 'for' loop expression
output "created_worker_files" {
  description = "List of worker node files created by count loop"
  value       = [for f in local_file.worker_nodes : f.filename]
}

# 4. Sensitive output (masked by default in standard CLI output)
# To view: terraform output -raw generated_admin_password
output "generated_admin_password" {
  description = "Generated admin password (marked sensitive to prevent terminal leaks)"
  value       = random_password.admin_password.result
  sensitive   = true
}

# 5. Output parsed JSON data read back through the Data Source
output "loaded_config_content" {
  description = "Parsed content of the configuration file read via data source"
  value       = jsondecode(data.local_file.read_config.content)
}
